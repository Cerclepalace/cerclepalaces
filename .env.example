# Copier en .env et remplir. Ne jamais commiter .env.

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/cbd_marketplace"

# File de dispatch, cache géo, rate limiting
REDIS_URL="redis://localhost:6379"

# Sessions — générer une valeur aléatoire longue, propre à chaque environnement
AUTH_SECRET=""

# URL publique : sert à construire les liens des QR codes imprimés
PUBLIC_BASE_URL="http://localhost:3000"

# Stockage objet (photos produits, documents de conformité)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Prestataire de paiement — TO_VERIFY décision 09, aucun fournisseur retenu.
# Ces clés restent côté serveur uniquement, jamais exposées au front.
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
